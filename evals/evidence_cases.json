      "tabular_values": [
        {"phase": "Phase 2", "trial_count": 1},
        {"phase": "Phase 3", "trial_count": 1}
      ],
      "used_nct_ids": ["NCT00000001", "NCT00000002"],
      "excluded_count": 0
    }
  },
