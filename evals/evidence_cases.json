  {
    "id": "phase-counts-with-provenance",
    "category": "aggregation",
    "plan": {
      "intent": "distribution",
      "interpretation": "Count distinct melanoma trials by phase.",
      "cohorts": [
        {
          "id": "all",
          "label": "Melanoma trials",
          "filters": [{"field": "condition", "operator": "contains", "values": ["Melanoma"]}]
        }
      ],
      "dimensions": [{"field": "phase"}],
      "measure": {"field": "nct_id", "aggregation": "count_distinct", "label": "Trial count", "unit": "trials"},
      "visualization": "bar_chart"
    },
    "expected": {
